      <script>
        <segment name="Fortran" id="1811696826" classid="CoreSegment"><![CDATA[#STORAGE REAL:11
!
#LOCAL REAL n      ! tuning to the 3. harmonic
#LOCAL REAL w      ! angular frequency
#LOCAL REAL Z_SCC  ! Short Circuit Impedance of the Network
#LOCAL REAL Phi    ! Phase angle
#LOCAL REAL A
#LOCAL REAL E
#LOCAL REAL F
#LOCAL REAL G
#LOCAL REAL B1
#LOCAL REAL B2
#LOCAL REAL B 


IF ( TIMEZERO ) THEN

n = 3.0
w = TWO_PI*$freq
Z_SCC = ($U_N*1e+3)**2/($S_SCC*1e+6)
Phi = atan($X_to_R)*(360/TWO_PI)
A = ABS(Z_SCC)*SIN(Phi/(360/TWO_PI))
E=SQRT(A)*n*(1-n)
F=A*TAN(Phi/(360/TWO_PI))*(1-n**2)
G=A**1.5*(n-1)
B1=(-F+SQRT(F**2-4*E*G))/(2*E)
B2=(-F-SQRT(F**2-4*E*G))/(2*E)

IF ( (B1 > 0.0).AND.( B2 < 0.0 ) ) THEN
      B = B1
ELSEIF ( (B2 > 0.0).AND.( B1 < 0.0 ) ) THEN
      B = B2
ENDIF

$L_p = (B**2+A)/w
$R_p = (w*$L_p*SQRT(A))/SQRT(w*$L_p-A)
$R_s = (((w*$L_p*n)/($R_p*TAN(Phi/(360/TWO_PI))))-(w*$L_p*n/$R_p)**2)/(1+(w*$L_p*n/$R_p)**2)*$R_p

ENDIF
!]]></segment>
        <segment name="Branch" id="1158927500" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Computations" id="1153940134" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
