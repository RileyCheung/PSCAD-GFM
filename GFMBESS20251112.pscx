        <line x1="-8" y1="-1" x2="-8" y2="-5" stroke="Navy" stroke-dasharray="none" stroke-width="0.2" port="" />
        <line x1="18" y1="-2" x2="18" y2="3" stroke="Navy" stroke-dasharray="none" stroke-width="0.2" port="" />
