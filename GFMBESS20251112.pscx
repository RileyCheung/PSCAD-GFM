        <port model="Transfer" name="Xin" x="-36" y="0" dim="1" mode="Input" type="Real" internal="false"><![CDATA[true]]></port>
        <port model="Transfer" name="Yout" x="36" y="0" dim="1" mode="Output" type="Real" internal="false"><![CDATA[true]]></port>
        <cond><![CDATA[true]]></cond>
        <text x="-3" y="10" stroke="Olive" fill="Black" font-size="Small" text-anchor="Middle"><![CDATA[s]]></text>
