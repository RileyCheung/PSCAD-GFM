        <line x1="36" y1="0" x2="27" y2="0" stroke="Blue" stroke-dasharray="none" stroke-width="0.6" />
        <line x1="-18" y1="0" x2="-23" y2="5" stroke="Blue" stroke-dasharray="none" stroke-width="0.6" />
