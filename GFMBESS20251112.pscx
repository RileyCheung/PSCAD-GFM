      <script>
        <segment name="Fortran" id="2000983861" classid="CoreSegment"><![CDATA[#STORAGE REAL:2
#LOCAL REAL X_OLD
#LOCAL REAL Y_OLD
      X_OLD = STORF(NSTORF)
      Y_OLD = STORF(NSTORF+1)
      IF (TIMEZERO) Y_OLD = $Y0
      $Yout = Y_OLD + ($Xin + X_OLD)*0.5*DELT
      IF ($Yout .GT. TWO_PI) $Yout = $Yout - TWO_PI
      STORF(NSTORF) = $Xin
      STORF(NSTORF+1) = $Yout
      NSTORF = NSTORF+2]]></segment>
        <segment name="Branch" id="949314034" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Computations" id="1916932660" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
